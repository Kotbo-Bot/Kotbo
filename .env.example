# Discord Bot
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CLIENT_OWNER_ID=
GUILD_ID=
DISCORD_REDIRECT_URI=http://localhost:8787/api/auth/discord/callback

# Database
# Docker Compose expose PostgreSQL sur le port 5433 par defaut.
DATABASE_URL=postgresql://kotbo:kotbo@localhost:5433/kotbo?schema=public
# Taille du pool de connexions du bot (defaut: 30). Le pool est gere par
# l'adaptateur pg, pas par `connection_limit` dans l'URL : ce parametre-la est
# ignore. Garder la somme des pools de tous les services sous le max_connections
# de l'instance Postgres, sinon les connexions refusees remontent en timeouts.
# DATABASE_POOL_SIZE=30
# Replica de lecture pour le dashboard et les analytics. Sans lui, les requetes
# marquees `prismaRead` concurrencent les ecritures du bot sur le meme pool.
# DATABASE_READ_REPLICA_URL=
# DATABASE_READ_POOL_SIZE=20

# Analytics
# Periode de vidage des compteurs en memoire vers Postgres (defaut: 60000).
# Descendre cette valeur multiplie les transactions ; la monter allonge la
# fenetre de perte en cas de crash brutal du bot.
# ANALYTICS_FLUSH_INTERVAL_MS=60000
# Nombre de lignes ecrites par instruction lors d'un vidage (defaut: 200). Un
# lot plus gros reduit le nombre d'allers-retours mais allonge la duree de la
# transaction, donc le temps pendant lequel une connexion du pool est prise.
# ANALYTICS_CHUNK_SIZE=200
# Attente maximale d'une connexion libre avant d'abandonner un lot (defaut:
# 15000) et duree maximale de la transaction (defaut: 30000). Le defaut Prisma
# de 2000 ms sur l'attente faisait perdre les lots des que le pool etait
# charge, avec un `P2028 Unable to start a transaction in the given time`.
# ANALYTICS_TX_MAX_WAIT_MS=15000
# ANALYTICS_TX_TIMEOUT_MS=30000
# Au-dela de ce nombre de membres en cache, le snapshot de presence n'inspecte
# qu'un membre sur N et extrapole. 0 = desactive (compteurs exacts).
# ANALYTICS_PRESENCE_SAMPLE_THRESHOLD=0

# YouTube
NATHAN_YOUTUBE_CHANNEL_ID=
YOUTUBE_API_KEY=
# Important: La clé API YouTube doit être configurée SANS restrictions de referer HTTP dans la Google Cloud Console.
# Allez dans https://console.cloud.google.com/apis/credentials, cliquez sur votre clé API,
# et sous "Restrictions d'application", choisissez "Aucune" pour les restrictions HTTP.
# La clé n'est utilisée que pour résoudre une chaîne lors de l'ajout d'un suivi.
# Le polling (nouvelles vidéos, Shorts, direct) passe par le flux RSS public : aucun quota consommé.

# Twitch (alertes de live) - https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Logging
LOG_LEVEL=info

# Redis / Queue / sessions dashboard (requis pour l'authentification web)
# Option 1: URL unique
REDIS_URL=redis://localhost:6379
# Option 2: host/port/password
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# Concurrence worker BullMQ (defaut: 2)
# BULLMQ_CONCURRENCY=2
# Durée du verrou renouvelable des jobs longs (2 minutes par défaut)
# BULLMQ_LOCK_DURATION_MS=120000
# Nombre de récupérations autorisées après interruption/redéploiement
# BULLMQ_MAX_STALLED_COUNT=3

# Sentry (Bot)
# BOT_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0

# Dashboard / Frontend
# URL publique du backend API (sans slash final)
# Exemple local: http://localhost:8787
# Exemple prod: https://api.votre-domaine.tld
VITE_API_URL=http://localhost:8787

# Sentry (Dashboard)
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=development
# VITE_SENTRY_RELEASE=
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# URL publique du dashboard pour les redirections OAuth
DASHBOARD_URL=http://localhost:5173

# Télémétrie des instances (voir apps/bot/src/services/system/statsService.ts)
# URL du serveur master vers lequel cette instance remonte ses statistiques.
# MASTER_API_URL=https://api.kotbo.fr
# Force la détection self-host indépendamment de DASHBOARD_URL.
# IS_SELF_HOSTED=false
# Secret partagé envoyé dans l'en-tête X-Kotbo-Ping-Secret. À définir côté
# master pour filtrer le spam grossier du endpoint public de ping ; comme ce
# secret vit dans un dépôt public, ce n'est qu'un frein, pas une sécurité
# cryptographique.
# STATS_PING_SECRET=

# Secret long et aléatoire utilisé notamment pour chiffrer les jetons Discord en session Redis
JWT_SECRET=

# Clé de chiffrement des jetons et secrets OAuth des Custom Bots, stockés en base.
# Facultative : JWT_SECRET sert à défaut. La changer rend les secrets déjà enregistrés illisibles.
CUSTOM_BOT_ENCRYPTION_KEY=

# Fenêtre facultative de migration des anciens Bearer JWT. Supprimer après la date indiquée.
# AUTH_LEGACY_BEARER_UNTIL=2026-07-13T00:00:00Z

# Origines CORS supplémentaires (séparées par des virgules).
# Les domaines *.kotbo.fr (dont dash.kotbo.fr) sont déjà autorisés automatiquement.
# CORS_ALLOWED_ORIGINS=https://panel.example.com

# Optionnel: active le mode strict qui bloque le démarrage si OAuth incomplet
# DASHBOARD_OAUTH_STRICT=false

# Traduction locale (LibreTranslate)
# Docker Compose expose LibreTranslate sur le port 5001 avec le profil translation.
# Une installation locale utilise souvent le port 5000 : adapte cette URL si besoin.
LIBRETRANSLATE_URL=http://localhost:5001
# LIBRETRANSLATE_API_KEY=

# Timeout des appels traduction (en millisecondes)
TRANSLATION_TIMEOUT_MS=7000

# ============================================================================
# FACTURATION STRIPE (optionnel)
# ============================================================================
# Sans STRIPE_SECRET_KEY, la facturation est desactivee : les routes /api/billing
# renvoient 503, la page Facturation du dashboard l'annonce, et aucun module
# n'est verrouille par une offre. C'est le mode normal en auto-heberge.
#
# Cle secrete du compte Stripe. sk_test_... en developpement, sk_live_... en
# production. A ne jamais commiter ni exposer au dashboard (elle reste cote bot).
# STRIPE_SECRET_KEY=sk_test_...
#
# Secret de signature du webhook, propre a CHAQUE endpoint webhook cree dans
# Stripe : celui de `stripe listen` en local differe de celui de production.
# Sans lui, tous les evenements recus sont rejetes en 400.
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# Identifiants des prix (`price_...`), un par offre et par periodicite.
# `bun run stripe:bootstrap` cree les produits et les prix dans Stripe a partir
# de PLAN_REGISTRY, puis affiche ces six lignes pretes a recopier.
# STRIPE_PRICE_PLUS_MONTHLY=price_...
# STRIPE_PRICE_PLUS_YEARLY=price_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_YEARLY=price_...
# STRIPE_PRICE_ULTIMATE_MONTHLY=price_...
# STRIPE_PRICE_ULTIMATE_YEARLY=price_...
#
# L'essai gratuit (15 jours, une fois par compte Discord) n'a pas de variable :
# sa duree est un engagement commercial, elle vit dans TRIAL_DAYS
# (packages/contracts/src/types/plans.ts) et doit etre la meme partout.

# ============================================================================
# WHITE-LABEL / MULTI-INSTANCE (optionnel)
# ============================================================================
# Les instances white-label sont configurées en base de données via la table
# whitelabel_instances. Chaque instance possède ses propres credentials Discord
# (token, client_id, client_secret), son URL dashboard, son port API, et son branding.
#
# Pour créer une instance white-label, insérez un enregistrement dans la table :
#
#   INSERT INTO whitelabel_instances (id, slug, name, enabled, "discordToken",
#     "discordClientId", "discordClientSecret", "dashboardUrl", "apiPort",
#     "brandName", "brandColor", "ownerId")
#   VALUES (gen_random_uuid(), 'ma-commu', 'Ma Communauté', true,
#     'BOT_TOKEN_ICI', 'CLIENT_ID_ICI', 'CLIENT_SECRET_ICI',
#     'https://panel.macommu.fr', 8788,
#     'Ma Communauté Bot', '#FF6B35', 'DISCORD_USER_ID_PROPRIETAIRE');
#
# Le launcher détecte automatiquement les instances actives au démarrage et
# lance un ShardingManager par token Discord distinct.
#
# Variables par défaut (instance principale) :
# DISCORD_TOKEN, DISCORD_CLIENT_ID, etc. (voir ci-dessus)
# Les instances WL overrident ces valeurs avec leur propre config en DB.
