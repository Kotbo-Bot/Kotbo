// ============================================================================
// LEVELING SEASONS - SAISONS COMPÉTITIVES
// ============================================================================

enum SeasonStatus {
  UPCOMING
  ACTIVE
  ENDED
}

model LevelingSeason {
  id String @id @default(cuid())

  guildId  String
  name     String
  number   Int

  status   SeasonStatus @default(UPCOMING)

  startDate DateTime
  endDate   DateTime

  /// Récompenses de fin de saison : `[{ rank, roleId, coins }]`, validées par
  /// `validateSeasonRewards` (@kotbo/shared).
  rewards Json?

  // Rôle exclusif attribué au top 1
  topRoleId String?

  /// Salon où annoncer l'ouverture et la clôture. Vide = aucune annonce.
  announceChannelId String?

  /// À la clôture, une saison de même durée prend la suite, sauf si une autre
  /// est déjà prévue.
  autoRenew Boolean @default(false)

  /// Rappel dans le salon d'annonce pendant les dernières 24 h.
  remindBeforeEnd Boolean @default(false)
  /// Rappel déjà envoyé ; remis à vide quand la date de fin change.
  reminderSentAt DateTime?

  // Leaderboard final archivé (JSON: [{ userId, xp, level, rank }])
  finalLeaderboard Json?

  /// Ce qui a réellement été donné à la clôture : `SeasonRewardOutcome[]`
  /// (@kotbo/shared), relu par `readSeasonRewardOutcomes`.
  grantedRewards Json?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  snapshots SeasonSnapshot[]
  baselines SeasonBaseline[]
  rankedEntries RankedSeasonEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, number])
  @@index([guildId, status])
  @@map("leveling_seasons")
}

/// XP de chaque membre à l'ouverture de la saison. Le classement de saison est
/// l'XP actuelle moins cette valeur : rien n'est remis à zéro. Un membre sans
/// ligne (arrivé en cours de saison) part de 0. Supprimées à la clôture, une
/// fois le classement figé dans `SeasonSnapshot`.
model SeasonBaseline {
  seasonId String
  userId   String
  xp       Int

  season LevelingSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@id([seasonId, userId])
  @@map("season_baselines")
}

/// Classement figé à la clôture. Depuis les saisons à référence, `xp` est l'XP
/// gagnée pendant la saison ; avant, c'était l'XP totale du membre.
model SeasonSnapshot {
  id String @id @default(cuid())

  guildId   String
  seasonId  String
  userId    String

  xp        Int @default(0)
  level     Int @default(0)
  rank      Int @default(0)

  messagesCount  Int @default(0)
  voiceMinutes   Int @default(0)

  guild  Guild          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  season LevelingSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([seasonId, userId])
  @@index([guildId, seasonId])
  @@index([seasonId, xp])
  @@map("season_snapshots")
}
