// ── Protection anti-raid & sécurité ──────────────────
// Captcha, anti-raid, join/DM lock, reports communautaires, tag role, scam filter.

model RaidProtectionConfig {
  guildId String @id

  // ── Captcha (vérification des nouveaux membres) ────────────────────────────
  captchaEnabled          Boolean @default(false)
  captchaChannelId        String? // Salon de vérification où le code doit être tapé
  captchaUnverifiedRoleId String? // Rôle @Non-vérifié appliqué à l'arrivée
  captchaVerifiedRoleId   String? // Rôle accordé une fois le captcha réussi
  captchaTimeoutMinutes   Int     @default(10) // Délai avant expiration (kick)
  captchaMaxAttempts      Int     @default(3)
  captchaFailAction       String  @default("KICK") // KICK | BAN
  captchaLogChannelId     String?
  captchaMode             String  @default("IMAGE") // IMAGE | VOICE
  captchaVoiceChannelId   String? // Salon vocal où le bot énonce le code
  // Langue d'énonciation. Un code est toujours énoncé entièrement dans une
  // seule langue : mélanger les prononciations le rendrait inintelligible.
  captchaVoiceLocale      String  @default("FR") // FR | EN
  // Au-delà de N membres en file d'attente vocale, les arrivants suivants
  // basculent sur le captcha image : la diffusion audio est sérielle, elle ne
  // peut pas absorber un raid.
  captchaVoiceQueueLimit  Int     @default(25)
  // Quand le captcha s'applique : ALWAYS (chaque arrivée), AUTO (raid ou
  // alerte Shield 3 et plus), SMART (AUTO + comptes au profil suspect).
  captchaTrigger          String  @default("ALWAYS")
  // L'icône du serveur est incrustée dans l'image du captcha.
  captchaUseServerIcon    Boolean @default(true)

  // ── Shield (niveau d'alerte du serveur) ────────────────────────────────────
  // 5 = tout va bien … 1 = catastrophe. Change seulement à la main.
  shieldLevel           Int       @default(5)
  shieldPanelChannelId  String?
  shieldPanelMessageId  String?
  // Salon vocal dont le nom affiche le niveau.
  shieldStatusChannelId String?
  // Ce que Shield a lui-même activé, pour ne défaire que ça au retour à 5 :
  // { verificationBefore, captchaEnabled, dmLock, raidMode, lockedBits }.
  shieldState           Json?
  shieldChangedAt       DateTime?
  shieldChangedBy       String?

  // ── Anti-raid (détection de vague de joins) ────────────────────────────────
  antiRaidEnabled            Boolean   @default(false)
  antiRaidJoinThreshold      Int       @default(10) // N arrivées…
  antiRaidJoinWindowSec      Int       @default(60) // …en T secondes
  antiRaidAction             String    @default("LOCK") // LOCK (joinlock) | CAPTCHA (captcha forcé) | KICK
  antiRaidAlertChannelId     String?
  antiRaidAutoDisableMinutes Int       @default(30) // Durée du raid mode avant désactivation auto
  raidModeActive             Boolean   @default(false)
  raidModeActivatedAt        DateTime?
  raidModeManual             Boolean   @default(false) // true = activé à la main (pas d'auto-disable)

  // ── Ancienneté minimale du compte Discord à l'arrivée ──────────────────────
  accountAgeGuardEnabled   Boolean  @default(false)
  accountAgeMinValue       Int      @default(7)
  accountAgeMinUnit        String   @default("DAYS") // DAYS | MONTHS
  accountAgeAction         String   @default("KICK") // ALERT | KICK | BAN
  accountAgeAlertChannelId String?
  accountAgeMessage        String   @default("Ton compte Discord est trop récent pour rejoindre ce serveur.")
  // Sans exemption, un compte légitime refoulé ne peut plus entrer avant
  // d'avoir atteint l'ancienneté : même un déban manuel est annulé au retour.
  accountAgeWhitelist      String[] @default([])

  // ── Join Lock (blocage des arrivées) ───────────────────────────────────────
  joinLockEnabled Boolean   @default(false)
  joinLockUntil   DateTime? // null = permanent (renouvelé par cron)
  joinLockKick    Boolean   @default(true) // Kick les membres qui rejoignent malgré tout
  joinLockMessage String    @default("Le serveur est temporairement fermé aux nouvelles arrivées. Merci de réessayer plus tard.")

  // ── DM Lock (blocage des MP entre membres, au-delà des 24h natives) ────────
  dmLockEnabled Boolean   @default(false)
  dmLockUntil   DateTime? // null = permanent (renouvelé par cron)

  // ── Reports communautaires (vers un salon staff) ───────────────────────────
  reportsEnabled     Boolean @default(false)
  reportsChannelId   String?
  reportsCooldownSec Int     @default(60) // Anti-abus : délai min entre deux reports d'un même membre
  reportsAnonymous   Boolean @default(false) // Masquer l'auteur du report dans l'embed staff

  // ── Tag Role (rôle auto pour les membres arborant le tag du serveur) ───────
  tagRoleEnabled Boolean @default(false)
  tagRoleId      String?

  // ── Scam filter (liens d'arnaques connus : faux Nitro, phishing…) ──────────
  scamFilterEnabled       Boolean  @default(false)
  scamFilterAction        String   @default("DELETE_AND_TIMEOUT") // DELETE | DELETE_AND_WARN | DELETE_AND_TIMEOUT | DELETE_AND_BAN
  scamFilterTimeoutMin    Int      @default(60)
  scamFilterCustomDomains String[] @default([]) // Domaines supplémentaires bloqués
  scamFilterWhitelist     String[] @default([]) // Domaines exemptés
  scamFilterAlertChannelId String?
  // Comparaison des images postées avec les hash d'images scam connues
  // (alimentées automatiquement par le honeypot)
  scamImageFilterEnabled  Boolean  @default(false)

  // ── Filtre de codes QR ─────────────────────────────────────────────────────
  // Le phishing par QR de connexion Discord ne contient aucun lien : aucun
  // filtre de domaine ne peut l'attraper. On bloque donc les images porteuses
  // d'un code QR postées par des comptes sans historique sur le serveur.
  scamQrFilterEnabled     Boolean  @default(false)
  // Au-delà de ce nombre de messages, un membre est considéré comme installé
  // et ses codes QR ne sont plus bloqués (partage légitime : wifi, 2FA, jeu).
  // Le même seuil réserve la lecture OCR aux comptes sans historique.
  scamQrTrustedMessages   Int      @default(50)

  // ── Lecture du texte des images (OCR local) ────────────────────────────────
  // Rattrape les captures photographiées ou recadrées que le hash ne reconnaît
  // pas : le domaine ou le texte lu dans l'image est comparé au jeu de données.
  // Coûteux en CPU, d'où l'activation explicite par serveur.
  scamOcrEnabled          Boolean  @default(false)

  // ── Invite Guard (contrôle des invitations) ────────────────────────────────
  inviteGuardEnabled      Boolean  @default(false)
  // Mode urgence : supprime TOUTES les invitations existantes + toute nouvelle invitation
  inviteEmergencyEnabled  Boolean  @default(false)
  // Supprime toute invitation non unitaire (maxUses != 1 : les 0/∞ sont refusées)
  inviteRequireUnitary    Boolean  @default(false)
  // Toute nouvelle invitation doit être validée par le staff (supprimée puis recréée si approuvée)
  inviteValidationEnabled Boolean  @default(false)
  // Anti-spam de création d'invitations : alerte staff au-delà du seuil
  inviteSpamThreshold     Int      @default(5)
  inviteSpamWindowSec     Int      @default(60)
  inviteAlertChannelId    String?
  // Rôles exemptés de toutes les règles d'invitation (le staff configuré l'est d'office)
  inviteBypassRoleIds     String[] @default([])

  // ── Rôles rendus au retour d'un membre ─────────────────────────────────────
  rolePersistEnabled Boolean  @default(false)
  rolePersistMode    String   @default("ALL") // ALL (sauf les rôles listés) | LIST (seulement les rôles listés)
  rolePersistRoleIds String[] @default([])
  rolePersistMaxDays Int      @default(90)
  // Rend aussi les rôles à permissions (staff, admin) et réinscrit le membre à l'annuaire staff
  rolePersistStaff   Boolean  @default(false)

  // ── Automod : autres serveurs ──────────────────────────────────────────────
  // Chaque comportement : OFF | BLACKLIST (serveurs listés refusés) |
  // WHITELIST (seuls les serveurs listés passent).
  otherInvitesMode   String   @default("OFF")
  // Invitations d'ami et de groupe : FOLLOW (suivent la liste) | ALLOW | BLOCK.
  otherFriendInvites String   @default("FOLLOW")
  // Messages transférés depuis un autre serveur, liens de salon ou d'événement.
  otherForwardsMode  String   @default("OFF")
  // Tag d'un autre serveur affiché sur le profil : quarantaine tant qu'il reste.
  otherTagsMode      String   @default("OFF")
  // Serveurs de la liste, « id|nom » (25 au plus). Le nom ne sert qu'à l'affichage.
  otherServers       String[] @default([])
  otherSanction      String   @default("DELETE")
  otherDurationMin   Int?     @default(60)

  // ── Automod : extensions de fichiers ───────────────────────────────────────
  // Règle du serveur ; les règles de salon et de catégorie sont dans
  // FileFilterRule et l'emportent (salon, puis catégorie, puis serveur).
  fileFilterMode       String   @default("OFF") // OFF | BLACKLIST | WHITELIST
  fileGroups           String[] @default([])    // EXECUTABLES | IMAGES | VIDEOS | AUDIO | ARCHIVES | DOCUMENTS
  fileExtensions       String[] @default([])
  // Fichier déguisé (un .exe renommé .png) supprimé même sans liste blanche.
  fileRejectCorrupted  Boolean  @default(false)
  fileSanction         String   @default("DELETE")
  fileDurationMin      Int?     @default(60)

  // ── Jail (quarantaine par rôle) ────────────────────────────────────────────
  // Le rôle Jail ne voit aucun salon, sauf celui réservé aux quarantaines s'il
  // existe. Les rôles du membre lui sont retirés et rendus à la levée.
  jailRoleId                  String?
  jailChannelId               String?
  jailStripRoles              Boolean  @default(true)
  // Si l'AutoMod natif de Discord met un profil en quarantaine (pseudo, bio ou
  // tag bloqué), Kotbo synchronise avec sa quarantaine Jail et la lève dès que
  // le membre corrige son profil.
  discordQuarantineSyncEnabled Boolean @default(false)

  // ── Kotbo Vision (filtre d'images d'arnaque) ───────────────────────────────────
  // Indépendant du filtre de liens : actif par défaut, comme le catalogue
  // global ne bloque que des images déjà confirmées sur plusieurs serveurs.
  visionEnabled         Boolean @default(true)
  // DELETE | WARN | TIMEOUT | KICK | SOFTBAN | BAN | JAIL
  visionSanction        String  @default("TIMEOUT")
  // Durée de la sanction en minutes ; null = permanente (BAN, JAIL).
  visionDurationMin     Int?    @default(1440)
  // Salon où sont signalées les correspondances incertaines du catalogue
  // global. Les listes personnalisées ont leur propre salon.
  visionReviewChannelId String?
  // Message privé à l'auteur sanctionné.
  visionNotifyMember    Boolean @default(true)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("raid_protection_configs")
}

// Règle d'extensions de fichiers propre à un salon, un fil ou une catégorie.
// La plus précise l'emporte ; une extension qu'aucune règle ne nomme passe.
model FileFilterRule {
  id         String   @id @default(cuid())
  guildId    String
  targetId   String   // salon, fil ou catégorie
  targetType String   @default("CHANNEL") // CHANNEL | CATEGORY
  mode       String   @default("BLACKLIST") // BLACKLIST | WHITELIST
  groups     String[] @default([])
  extensions String[] @default([])
  createdAt  DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, targetId])
  @@map("file_filter_rules")
}

// Membre en quarantaine. Les rôles retirés à l'entrée sont rendus à la levée ;
// la ligne survit à un départ pour reposer le rôle si le membre revient.
model MemberJail {
  guildId    String
  userId     String
  sanctionId String?
  // MANUAL | SERVER_TAG | ACCOUNT_AGE | DISCORD_QUARANTINE | HONEYPOT | VISION
  source     String   @default("MANUAL")
  roleIds    String[] @default([])
  reason     String?
  // null = jusqu'à levée manuelle (ou disparition de la cause pour SERVER_TAG
  // et DISCORD_QUARANTINE).
  releaseAt  DateTime?
  createdAt  DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, userId])
  @@index([releaseAt])
  @@index([guildId, source])
  @@map("member_jails")
}

// Catalogue Kotbo Vision personnalisé : un registre d'images interdites, propre au
// serveur. Une liste = un seul type de contenu, sinon les variantes rattachées
// faussent la détection.
model VisionList {
  id              String   @id @default(cuid())
  guildId         String
  name            String
  enabled         Boolean  @default(true)
  // Salon où sont signalées les images proches mais non certaines.
  reviewChannelId String?
  // Sanction propre à la liste ; null = celle de Kotbo Vision.
  sanction        String?
  durationMin     Int?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  guild  Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)
  images ScamImageHash[]

  @@unique([guildId, name])
  @@map("vision_lists")
}

// Image proche d'une image interdite, en attente de décision du staff.
model VisionReview {
  id       String  @id @default(cuid())
  guildId  String
  listId   String?
  // Entrée du catalogue la plus proche.
  matchId  String?
  score    Float

  authorId  String
  channelId String
  sha256    String
  fingerprint String
  thumb     String?

  status          String    @default("PENDING") // PENDING | CONFIRMED | DISMISSED
  reviewMessageId String?
  handledBy       String?
  handledAt       DateTime?
  createdAt       DateTime  @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, status])
  @@index([guildId, sha256])
  @@map("vision_reviews")
}

// Rôles d'un membre au moment de son départ, rendus à son retour puis supprimés.
model MemberRoleSnapshot {
  guildId String
  userId  String
  roleIds String[]
  leftAt  DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, userId])
  @@index([leftAt])
  @@map("member_role_snapshots")
}

model CaptchaSession {
  id      String @id @default(cuid())
  guildId String
  userId  String

  code     String
  attempts Int    @default(0)
  status   String @default("PENDING") // PENDING | VERIFIED | FAILED | EXPIRED
  mode     String @default("IMAGE") // IMAGE | VOICE

  messageId String? // Message du bot contenant l'image captcha (nettoyé après vérif)

  // Le membre attend son tour dans la file vocale : son chrono n'a pas démarré
  // et le cron d'expiration doit l'ignorer, sinon la file expulse les légitimes.
  awaitingTurn Boolean @default(false)

  createdAt DateTime @default(now())
  expiresAt DateTime

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, userId, status])
  @@index([status, expiresAt])
  @@map("captcha_sessions")
}

// Hash d'images d'arnaques connues. Alimenté automatiquement quand un membre
// piégé par le honeypot poste une image, ou manuellement par le staff.
model ScamImageHash {
  id      String  @id @default(cuid())
  guildId String? // null = hash global (partagé entre tous les serveurs)

  hash     String // SHA-256 des octets de l'image
  // Empreinte perceptuelle (dHash 64 bits, hexadécimal). Le SHA-256 casse dès
  // qu'un pixel change ou que l'image est recompressée ; le dHash survit à la
  // recompression et au recadrage léger, ce qui est exactement le mode de
  // diffusion des captures d'arnaque.
  phash    String?
  filename String?
  source   String @default("HONEYPOT") // HONEYPOT | MANUAL | QR
  addedBy  String? // userId du membre à l'origine (auteur du scam ou staff)

  // Texte lu dans l'image (OCR local), normalisé. Une capture photographiée ou
  // recadrée échappe au hash, mais son texte (« Withdrawal Success », nom de
  // domaine, code promo) reste identique : c'est ce qui sert de jeu d'exemples.
  ocrText String?

  // Empreinte Kotbo Vision v2 (cf. imageForensics.fingerprintImage) : dHash
  // horizontal et vertical + pHash DCT, sur l'image débarrassée de ses bords et
  // sur son centre. Absente des entrées antérieures, qui retombent sur phash.
  fingerprint String?
  // Vignette JPEG (data URL) pour le catalogue du dashboard. Les URL Discord
  // expirent : sans elle, une liste serait une colonne de hash illisibles.
  thumb       String?
  // Liste personnalisée ; null = catalogue de détection (honeypot, global).
  listId      String?
  // Variante apprise d'une autre entrée (même image recadrée, recompressée).
  parentId    String?
  // BLOCKED = interdite ; ALLOWED = écartée par le staff, ne plus signaler.
  status      String   @default("BLOCKED")
  hits        Int      @default(0)
  lastSeenAt  DateTime?

  createdAt DateTime @default(now())

  guild Guild?          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  list  VisionList?  @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([guildId, hash])
  @@index([hash])
  @@index([guildId, phash])
  @@index([listId])
  @@map("scam_image_hashes")
}

// Domaines vus dans des messages piégés par le honeypot. Une ligne locale
// (guildId renseigné) devient une ligne globale (guildId null) quand le domaine
// a été vu sur assez de serveurs distincts : un seul honeypot mal configuré ne
// peut donc pas bloquer un domaine légitime pour tout le monde.
model ScamDomain {
  id      String  @id @default(cuid())
  guildId String? // null = domaine global (partagé entre tous les serveurs)

  domain String // en minuscules, sans schéma ni chemin
  source String @default("HONEYPOT") // HONEYPOT | MANUAL | PROMOTED | OCR
  hits   Int    @default(1)

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  guild Guild? @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, domain])
  @@index([domain])
  @@map("scam_domains")
}

// Textes d'arnaque (normalisés) vus dans le honeypot. L'empreinte sert à
// reconnaître un copier-coller ; l'échantillon et les signaux alimentent le jeu
// de données pour affiner les heuristiques.
model ScamTextSample {
  id      String  @id @default(cuid())
  guildId String? // null = empreinte globale

  fingerprint String // SHA-256 du texte normalisé
  sample      String // texte normalisé, tronqué
  signals     String[] @default([]) // signaux heuristiques déclenchés (giveaway, crypto_casino…)
  domains     String[] @default([]) // domaines trouvés dans le message
  source      String   @default("HONEYPOT") // HONEYPOT | MANUAL | PROMOTED | OCR
  hits        Int      @default(1)

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  guild Guild? @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, fingerprint])
  @@index([fingerprint])
  @@map("scam_text_samples")
}

// Demande de validation d'invitation : l'invitation d'origine est supprimée,
// et recréée seulement si le staff approuve.
model InviteApprovalRequest {
  id      String @id @default(cuid())
  guildId String

  creatorId String
  channelId String
  inviteCode String? // Code de l'invitation supprimée (trace)
  maxUses    Int     @default(1)
  maxAgeSec  Int     @default(86400)
  temporary  Boolean @default(false)

  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  handledById String?
  handledAt   DateTime?
  // Code de l'invitation recréée après approbation
  approvedInviteCode String?

  createdAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, status])
  @@map("invite_approval_requests")
}

model MemberReport {
  id      String @id @default(cuid())
  guildId String

  reporterId String
  targetId   String
  reason     String

  // Contexte optionnel quand le report vise un message précis
  channelId      String?
  messageId      String?
  messageContent String?

  status      String    @default("PENDING") // PENDING | RESOLVED | DISMISSED
  handledById String?
  handledAt   DateTime?

  createdAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, status, createdAt])
  @@index([guildId, targetId])
  @@map("member_reports")
}

// Salon verrouillé par /protection lockdown, avec l'état d'origine des permissions touchées
// pour les rendre à l'identique au déverrouillage.
model ChannelLockdown {
  guildId     String
  channelId   String
  // { permission: "allow" | "deny" | "neutral" } pour @everyone, puis pour le bot lui-même
  everyoneWas Json
  botWas      Json?
  reason      String?
  lockedById  String
  lockedAt    DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, channelId])
  @@map("channel_lockdowns")
}
