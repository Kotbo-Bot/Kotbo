// ============================================================================
// CELLULE BIEN-ÊTRE (ESPACE CONFIDENTIEL CLOISONNÉ) & MULTI-SERVEURS PUBLICS
// ============================================================================

model WellbeingConfig {
  guildId          String   @id
  enabled          Boolean  @default(false)
  teamRoleIds      String[] @default([])
  teamUserIds      String[] @default([])
  directorRoleIds  String[] @default([])
  directorUserIds  String[] @default([])
  requireReason    Boolean  @default(true)
  // Alertes : salon et membres prévenus, et événements qui les déclenchent
  // (BREAK_GLASS | EMERGENCY_READ | TEAM_READ | CASE_CHANGE | CONFIG_CHANGE | REPORT | REMINDER | MEMBERSHIP_CHANGE | PURGE_SOON | UNUSUAL_ACCESS | DISSOLUTION | DISTRESS | SANCTION_SIGNAL).
  alertChannelId   String?
  alertUserIds     String[] @default([])
  alertEvents      String[] @default(["BREAK_GLASS", "EMERGENCY_READ", "CONFIG_CHANGE", "REPORT", "REMINDER", "MEMBERSHIP_CHANGE", "PURGE_SOON", "UNUSUAL_ACCESS", "DISSOLUTION", "DISTRESS"])
  // Accès d'urgence validé par une seconde personne (direction ou cellule).
  breakGlassApproval Boolean @default(false)
  // Signalements depuis Discord (/bienetre signaler).
  reportEnabled    Boolean  @default(false)
  // Relance d'un dossier critique resté sans activité pendant ce nombre de jours.
  staleCriticalDays Int     @default(7)
  // Ressources d'aide : [{ label, url?, phone?, description? }].
  resources        Json     @default("[]")
  // Revue périodique des accès : dernière confirmation du propriétaire, dernier rappel envoyé.
  accessReviewedAt   DateTime?
  accessReviewSentAt DateTime?
  // Suppléant : reçoit les relances des dossiers dont le référent est absent.
  backupUserId       String?
  // Dernier résumé hebdomadaire envoyé aux membres de la cellule.
  digestSentAt       DateTime?
  // Désactivation demandée par le propriétaire : appliquée 24 h plus tard, annulable d'ici là.
  // `dissolutionKind` : CONFIG (cellule désactivée) ou MODULE (module éteint).
  dissolutionAt      DateTime?
  dissolutionById    String?
  dissolutionByName  String?
  dissolutionKind    String?
  // Protocole de crise : étapes ajoutées au plan d'action d'un dossier qui devient critique.
  crisisProtocol     Boolean  @default(true)
  // Rappel « prendre des nouvelles » d'un dossier résolu, ce nombre de jours après (0 : jamais).
  followUpDays       Int      @default(30)
  // Prévenir le modérateur et le référent quand une personne suivie est sanctionnée.
  sanctionSignal     Boolean  @default(false)
  // Repérer les mots de détresse dans les messages du serveur.
  distressWatch      Boolean  @default(false)
  // Météo du staff : sondage anonyme du lundi aux membres de ces rôles.
  pulseEnabled       Boolean  @default(false)
  pulseRoleIds       String[] @default([])
  pulseSentAt        DateTime?
  // Référents partagés avec les autres cellules du réseau de serveurs qui
  // partagent aussi : un dossier peut être confié à l'un de leurs membres.
  networkPool        Boolean  @default(false)
  // Durée de vie d'une note de fiche, en mois (1 à 36) ; 3 mois après le départ du serveur.
  profileRetentionMonths Int  @default(12)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wellbeing_configs")
}

model WellbeingCase {
  id             String   @id @default(cuid())
  guildId        String
  subjectUserId  String?
  subjectName    String
  title          String
  category       String   @default("SOUTIEN") // SOUTIEN | MEDIATION | SIGNALEMENT | SUIVI
  severity       String   @default("NORMAL")  // LOW | NORMAL | HIGH | CRITICAL
  status         String   @default("OPEN")    // OPEN | MONITORING | CLOSED
  // Titre, personne concernée et résumé sont chiffrés (wellbeingCrypto).
  summary        String
  createdById    String
  createdByName  String
  source         String   @default("DASHBOARD") // DASHBOARD | DISCORD | TICKET | DISTRESS
  // Ticket transféré à la cellule : un ticket ne devient qu'un seul dossier.
  ticketId       String?  @unique
  // Référent du dossier et prochaine échéance de suivi.
  assigneeId       String?
  reviewAt         DateTime?
  reviewRemindedAt DateTime?
  staleRemindedAt  DateTime?
  // Dernier geste réel (création, modification, note) : les relances ne le déplacent pas.
  lastActivityAt   DateTime @default(now())
  // Corbeille : un dossier supprimé reste restaurable 30 jours, puis il est purgé.
  deletedAt        DateTime?
  deletedById      String?
  deletedByName    String?
  // Effacement anticipé de la corbeille, à valider par une seconde personne.
  purgeRequestedById   String?
  purgeRequestedByName String?
  purgeRequestedAt     DateTime?
  // Annonce de l'effacement d'un dossier fermé, envoyée une semaine avant.
  purgeWarnedAt        DateTime?
  // Signalement Discord : empreinte du code de suivi remis à son auteur (le code n'est pas gardé).
  trackingCodeHash     String?   @unique
  // Motif de clôture (RESOLVED | REFERRED | NO_FOLLOWUP | DUPLICATE), vidé à la réouverture.
  closedReason         String?
  // Dossier résolu : rappel de prendre des nouvelles, et sa date d'envoi.
  followUpAt           DateTime?
  followUpSentAt       DateTime?
  // Référent du réseau : membre de la cellule d'un autre serveur du réseau,
  // qui lit et annote ce dossier depuis la cellule de son serveur.
  networkReferentId      String?
  networkReferentGuildId String?

  guild  Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  reporterMessages WellbeingReporterMessage[]
  notes       WellbeingCaseNote[]
  tasks       WellbeingCaseTask[]
  events      WellbeingCaseEvent[]
  attachments WellbeingCaseAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, status])
  @@index([status, reviewAt])
  @@index([guildId, deletedAt])
  @@index([status, followUpAt])
  @@index([networkReferentId])
  @@map("wellbeing_cases")
}

// Fiche confidentielle : ce que la cellule sait d'une personne, sans rien à
// traiter. Une par personne et par serveur ; elle disparaît avec sa dernière note.
model WellbeingProfile {
  id            String    @id @default(cuid())
  guildId       String
  subjectUserId String
  // Nom de la personne, chiffré et lié au serveur (wellbeingCrypto).
  subjectName   String
  // Départ du serveur : les notes ne vivent plus que 3 mois.
  subjectLeftAt DateTime?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  notes WellbeingProfileNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, subjectUserId])
  @@map("wellbeing_profiles")
}

// Note d'une fiche, chiffrée et liée à sa fiche, avec sa propre échéance.
model WellbeingProfileNote {
  id             String    @id @default(cuid())
  profileId      String
  authorId       String
  authorName     String
  content        String
  expiresAt      DateTime
  // Annonce de l'effacement, une semaine avant ; vidée par une prolongation.
  purgeWarnedAt  DateTime?
  // Dernière prolongation et son motif (chiffré comme la note).
  extendedAt     DateTime?
  extendedById   String?
  extendedByName String?
  extendedReason String?

  profile WellbeingProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([profileId, createdAt])
  @@index([expiresAt])
  @@map("wellbeing_profile_notes")
}

// Échanges anonymes avec l'auteur d'un signalement, lus et écrits par lui avec
// son code de suivi. Le contenu est chiffré et lié au serveur, comme le dossier.
model WellbeingReporterMessage {
  id           String   @id @default(cuid())
  caseId       String
  fromReporter Boolean
  content      String
  // Membre de la cellule qui a écrit ; vide pour le signaleur, jamais connu.
  authorId     String?
  createdAt    DateTime @default(now())

  wellbeingCase WellbeingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@map("wellbeing_reporter_messages")
}

// Message aux mots de détresse repéré sur le serveur : un lien, jamais son
// contenu. La cellule ouvre un dossier ou l'écarte ; effacé après 30 jours.
model WellbeingDistressSignal {
  id            String    @id @default(cuid())
  guildId       String
  userId        String
  channelId     String
  messageId     String
  createdAt     DateTime  @default(now())
  handledAt     DateTime?
  handledById   String?
  handledByName String?
  // CASE | DISMISSED
  outcome       String?
  caseId        String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, handledAt])
  @@index([createdAt])
  @@map("wellbeing_distress_signals")
}

// Météo du staff : compteurs de notes par semaine, sans lien avec qui a voté.
model WellbeingPulseWeek {
  guildId String
  week    String
  score1  Int    @default(0)
  score2  Int    @default(0)
  score3  Int    @default(0)
  score4  Int    @default(0)
  score5  Int    @default(0)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, week])
  @@map("wellbeing_pulse_weeks")
}

// Qui a déjà répondu cette semaine, par empreinte : un seul vote par personne.
// Effacé une fois la semaine passée.
model WellbeingPulseVoter {
  guildId   String
  week      String
  voterHash String

  @@id([guildId, week, voterHash])
  @@map("wellbeing_pulse_voters")
}

model WellbeingCaseNote {
  id         String   @id @default(cuid())
  caseId     String
  authorId   String
  authorName String
  content    String
  createdAt  DateTime @default(now())
  // Correction par l'auteur : la première version reste lisible, chiffrée comme la note.
  originalContent String?
  editedAt        DateTime?

  wellbeingCase WellbeingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@map("wellbeing_case_notes")
}

// Document Google Drive joint à un dossier. Seul le lien est gardé, chiffré
// avec son nom (wellbeingCrypto) ; le fichier reste chez Google.
model WellbeingCaseAttachment {
  id          String   @id @default(cuid())
  caseId      String
  label       String
  url         String
  addedById   String
  addedByName String
  createdAt   DateTime @default(now())

  wellbeingCase WellbeingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@map("wellbeing_case_attachments")
}

// Plan d'action d'un dossier : tâches cochées au fil du suivi. Le libellé est
// chiffré et lié à son dossier, comme une note.
model WellbeingCaseTask {
  id            String    @id @default(cuid())
  caseId        String
  label         String
  assigneeId    String?
  dueAt         DateTime?
  doneAt        DateTime?
  doneById      String?
  createdById   String
  createdByName String
  createdAt     DateTime  @default(now())

  wellbeingCase WellbeingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@map("wellbeing_case_tasks")
}

// Historique d'un dossier : qui a changé quoi, et quand. Aucun contenu.
model WellbeingCaseEvent {
  id        String   @id @default(cuid())
  caseId    String
  actorId   String?
  actorName String
  type      String   // CREATED | STATUS | SEVERITY | ASSIGNEE | REVIEW | NOTE | RESOURCES_SENT | REMINDER | ATTACHMENT_ADDED | ATTACHMENT_REMOVED | VIEWED | TRASHED | RESTORED | EXTENDED | EXPORTED | TASK_ADDED | TASK_DONE | TASK_REOPENED | TASK_REMOVED | PURGE_REQUESTED | CLOSED_REASON | NOTE_EDITED | REPORTER_REPLY | NETWORK_REFERENT
  fromValue String?
  toValue   String?
  createdAt DateTime @default(now())
  // Empreinte liée à l'entrée précédente du dossier : une entrée modifiée ou
  // retirée en base casse la chaîne. Vide pour les entrées d'avant le chaînage.
  hash      String?

  wellbeingCase WellbeingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@map("wellbeing_case_events")
}

model WellbeingBreakGlassLog {
  id         String   @id @default(cuid())
  guildId    String
  actorId    String
  actorName  String
  caseId     String?
  // Accès limité aux dossiers de ce membre, si renseigné.
  subjectUserId String?
  reason     String
  // PENDING tant qu'une seconde personne n'a pas validé, puis APPROVED ou REJECTED ;
  // ENDED quand l'accès (ou la demande) est arrêté avant son échéance.
  status         String    @default("APPROVED")
  approvedById   String?
  approvedByName String?
  decidedAt      DateTime?
  endedById      String?
  endedByName    String?
  endedAt        DateTime?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, actorId, expiresAt])
  @@map("wellbeing_break_glass_logs")
}

model GuildNetwork {
  id                   String   @id @default(cuid())
  name                 String
  ownerUserId          String
  planKey              String   @default("NETWORK_ASSOC")
  maxGuilds            Int      @default(5)
  billingStatus        String   @default("ACTIVE")
  stripeSubscriptionId String?
  notes                String?

  members GuildNetworkMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
  @@map("guild_networks")
}

model GuildNetworkMember {
  id        String   @id @default(cuid())
  networkId String
  guildId   String
  role      String   @default("MEMBER") // PRIMARY | MEMBER
  addedById String
  addedAt   DateTime @default(now())

  network GuildNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)
  guild   Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([networkId, guildId])
  @@index([guildId])
  @@map("guild_network_members")
}
