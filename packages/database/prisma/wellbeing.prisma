// ============================================================================
// CELLULE BIEN-ÊTRE (ESPACE CONFIDENTIEL CLOISONNÉ) & MULTI-SERVEURS PUBLICS
// ============================================================================

model WellbeingConfig {
  guildId          String   @id
  enabled          Boolean  @default(false)
  teamRoleIds      String[] @default([])
  teamUserIds      String[] @default([])
  directorRoleIds  String[] @default([])
  directorUserIds  String[] @default([])
  requireReason    Boolean  @default(true)
  // Alertes : salon et membres prévenus, et événements qui les déclenchent
  // (BREAK_GLASS | EMERGENCY_READ | TEAM_READ | CASE_CHANGE | CONFIG_CHANGE | REPORT | REMINDER | MEMBERSHIP_CHANGE | PURGE_SOON | UNUSUAL_ACCESS).
  alertChannelId   String?
  alertUserIds     String[] @default([])
  alertEvents      String[] @default(["BREAK_GLASS", "EMERGENCY_READ", "CONFIG_CHANGE", "REPORT", "REMINDER", "MEMBERSHIP_CHANGE", "PURGE_SOON", "UNUSUAL_ACCESS"])
  // Accès d'urgence validé par une seconde personne (direction ou cellule).
  breakGlassApproval Boolean @default(false)
  // Signalements depuis Discord (/bienetre signaler).
  reportEnabled    Boolean  @default(false)
  // Relance d'un dossier critique resté sans activité pendant ce nombre de jours.
  staleCriticalDays Int     @default(7)
  // Ressources d'aide : [{ label, url?, phone?, description? }].
  resources        Json     @default("[]")
  // Revue périodique des accès : dernière confirmation du propriétaire, dernier rappel envoyé.
  accessReviewedAt   DateTime?
  accessReviewSentAt DateTime?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wellbeing_configs")
}

model WellbeingCase {
  id             String   @id @default(cuid())
  guildId        String
  subjectUserId  String?
  subjectName    String
  title          String
  category       String   @default("SOUTIEN") // SOUTIEN | MEDIATION | SIGNALEMENT | SUIVI
  severity       String   @default("NORMAL")  // LOW | NORMAL | HIGH | CRITICAL
  status         String   @default("OPEN")    // OPEN | MONITORING | CLOSED
  // Titre, personne concernée et résumé sont chiffrés (wellbeingCrypto).
  summary        String
  createdById    String
  createdByName  String
  source         String   @default("DASHBOARD") // DASHBOARD | DISCORD
  // Référent du dossier et prochaine échéance de suivi.
  assigneeId       String?
  reviewAt         DateTime?
  reviewRemindedAt DateTime?
  staleRemindedAt  DateTime?
  // Dernier geste réel (création, modification, note) : les relances ne le déplacent pas.
  lastActivityAt   DateTime @default(now())
  // Corbeille : un dossier supprimé reste restaurable 30 jours, puis il est purgé.
  deletedAt        DateTime?
  deletedById      String?
  deletedByName    String?
  // Effacement anticipé de la corbeille, à valider par une seconde personne.
  purgeRequestedById   String?
  purgeRequestedByName String?
  purgeRequestedAt     DateTime?
  // Annonce de l'effacement d'un dossier fermé, envoyée une semaine avant.
  purgeWarnedAt        DateTime?
  // Signalement Discord : empreinte du code de suivi remis à son auteur (le code n'est pas gardé).
  trackingCodeHash     String?   @unique

  guild  Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  notes       WellbeingCaseNote[]
  tasks       WellbeingCaseTask[]
  events      WellbeingCaseEvent[]
  attachments WellbeingCaseAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, status])
  @@index([status, reviewAt])
  @@index([guildId, deletedAt])
  @@map("wellbeing_cases")
}

model WellbeingCaseNote {
  id         String   @id @default(cuid())
  caseId     String
  authorId   String
  authorName String
  content    String
  createdAt  DateTime @default(now())

  wellbeingCase WellbeingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@map("wellbeing_case_notes")
}

// Document Google Drive joint à un dossier. Seul le lien est gardé, chiffré
// avec son nom (wellbeingCrypto) ; le fichier reste chez Google.
model WellbeingCaseAttachment {
  id          String   @id @default(cuid())
  caseId      String
  label       String
  url         String
  addedById   String
  addedByName String
  createdAt   DateTime @default(now())

  wellbeingCase WellbeingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@map("wellbeing_case_attachments")
}

// Plan d'action d'un dossier : tâches cochées au fil du suivi. Le libellé est
// chiffré et lié à son dossier, comme une note.
model WellbeingCaseTask {
  id            String    @id @default(cuid())
  caseId        String
  label         String
  assigneeId    String?
  dueAt         DateTime?
  doneAt        DateTime?
  doneById      String?
  createdById   String
  createdByName String
  createdAt     DateTime  @default(now())

  wellbeingCase WellbeingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@map("wellbeing_case_tasks")
}

// Historique d'un dossier : qui a changé quoi, et quand. Aucun contenu.
model WellbeingCaseEvent {
  id        String   @id @default(cuid())
  caseId    String
  actorId   String?
  actorName String
  type      String   // CREATED | STATUS | SEVERITY | ASSIGNEE | REVIEW | NOTE | RESOURCES_SENT | REMINDER | ATTACHMENT_ADDED | ATTACHMENT_REMOVED | VIEWED | TRASHED | RESTORED | EXTENDED | EXPORTED | TASK_ADDED | TASK_DONE | TASK_REOPENED | TASK_REMOVED | PURGE_REQUESTED
  fromValue String?
  toValue   String?
  createdAt DateTime @default(now())
  // Empreinte liée à l'entrée précédente du dossier : une entrée modifiée ou
  // retirée en base casse la chaîne. Vide pour les entrées d'avant le chaînage.
  hash      String?

  wellbeingCase WellbeingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@map("wellbeing_case_events")
}

model WellbeingBreakGlassLog {
  id         String   @id @default(cuid())
  guildId    String
  actorId    String
  actorName  String
  caseId     String?
  // Accès limité aux dossiers de ce membre, si renseigné.
  subjectUserId String?
  reason     String
  // PENDING tant qu'une seconde personne n'a pas validé, puis APPROVED ou REJECTED ;
  // ENDED quand l'accès (ou la demande) est arrêté avant son échéance.
  status         String    @default("APPROVED")
  approvedById   String?
  approvedByName String?
  decidedAt      DateTime?
  endedById      String?
  endedByName    String?
  endedAt        DateTime?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, actorId, expiresAt])
  @@map("wellbeing_break_glass_logs")
}

model GuildNetwork {
  id                   String   @id @default(cuid())
  name                 String
  ownerUserId          String
  planKey              String   @default("NETWORK_ASSOC")
  maxGuilds            Int      @default(5)
  billingStatus        String   @default("ACTIVE")
  stripeSubscriptionId String?
  notes                String?

  members GuildNetworkMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
  @@map("guild_networks")
}

model GuildNetworkMember {
  id        String   @id @default(cuid())
  networkId String
  guildId   String
  role      String   @default("MEMBER") // PRIMARY | MEMBER
  addedById String
  addedAt   DateTime @default(now())

  network GuildNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)
  guild   Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([networkId, guildId])
  @@index([guildId])
  @@map("guild_network_members")
}
