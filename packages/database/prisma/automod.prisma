model BannedWord {
  id       String  @id @default(cuid())
  guildId  String? // null = global (visible par tous les serveurs, read-only dashboard)
  word     String
  category String  @default("custom") // custom | racism | threat | sexual | lgbtphobia | etc.
  enabled  Boolean @default(true)

  guild Guild? @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, word])
  @@index([guildId, enabled])
  @@map("banned_words")
}


model AutoModConfig {
  guildId              String   @id
  discordAutoModEnabled Boolean  @default(true)
  spamEnabled          Boolean  @default(false)
  spamLimit            Int      @default(5)     // Max messages in interval
  spamIntervalSeconds  Int      @default(5)
  spamAction           String   @default("TIMEOUT") // WARN, TIMEOUT
  // Spam à plusieurs dans un même salon : mode lent au lieu des sanctions individuelles
  spamGroupSlowmodeEnabled Boolean @default(false)
  spamGroupSlowmodeSeconds Int     @default(10)
  spamGroupSlowmodeMinutes Int     @default(5)
  // Mode lent préventif : s'active avant même qu'un membre dépasse sa limite individuelle
  // quand le débit global du salon s'emballe (N messages de M membres en T secondes).
  preventiveSlowmodeEnabled      Boolean @default(false)
  preventiveSlowmodeMsgThreshold Int     @default(15)
  preventiveSlowmodeMinUsers     Int     @default(3)
  preventiveSlowmodeWindowSec    Int     @default(10)
  preventiveSlowmodeSeconds      Int     @default(5)
  preventiveSlowmodeMinutes      Int     @default(5)

  linksEnabled         Boolean  @default(false)
  linksAction          String   @default("DELETE_AND_WARN")
  linksWhitelist       String[] @default([]) // Whitelisted domains

  capsEnabled          Boolean  @default(false)
  capsThresholdPercent Int      @default(80)
  capsMinLength        Int      @default(10)

  emojisEnabled        Boolean  @default(false)
  emojisLimit          Int      @default(10)

  mentionsEnabled      Boolean  @default(false)
  mentionsLimit        Int      @default(5)

  ghostPingEnabled     Boolean  @default(false)
  ghostPingAction      String   @default("ALERT")   // ALERT, WARN

  antiEveryoneEnabled  Boolean  @default(false)
  antiEveryoneAction   String   @default("DELETE_AND_WARN")

  // Native Discord AutoMod - Custom Words Filter (Keyword trigger)
  customWordsEnabled     Boolean  @default(false)
  customWordsAction      String   @default("BLOCK") // BLOCK, TIMEOUT, ALERT
  customWords            String[] @default([])
  customWordsAllowList   String[] @default([])
  customWordsTimeoutSec  Int      @default(60)

  // Native Discord AutoMod - Profanity Filter (KeywordPreset trigger)
  profanityEnabled       Boolean  @default(false)
  profanityPresetProfanity Boolean @default(true)
  profanityPresetSexual  Boolean  @default(true)
  profanityPresetSlurs   Boolean  @default(true)
  profanityAction        String   @default("BLOCK") // BLOCK, TIMEOUT, ALERT
  profanityAllowList     String[] @default([])
  profanityTimeoutSec    Int      @default(60)

  // Native Discord AutoMod - Invite Filter (Keyword trigger for invite links)
  inviteFilterEnabled    Boolean  @default(false)
  inviteFilterAction     String   @default("BLOCK") // BLOCK, TIMEOUT, ALERT
  inviteFilterAllowedGuilds String[] @default([])
  inviteFilterTimeoutSec Int      @default(60)

  antiBotEnabled       Boolean  @default(false)
  antiBotAction        String   @default("KICK") // KICK, BAN
  antiBotBypassUsers   String[] @default([]) // User IDs autorisés à ajouter des bots
  // Rôles donnés aux bots à leur arrivée, à la place du rôle automatique.
  antiBotRoleIds       String[] @default([])

  bypassRoles          String[] @default([])
  bypassChannels       String[] @default([])

  // Admin Permission Lock - empêche l'octroi non autorisé de la permission ADMINISTRATOR
  adminLockEnabled         Boolean  @default(false)
  adminLockAction          String   @default("BLOCK") // voie bot-mediated ; la voie native est toujours auto-revert
  adminLockSecurityRoleIds String[] @default([]) // rôles "sécurité" habilités à approuver/rejeter, en plus du owner
  adminLockNotifyChannelId String? // salon staff/log dédié (fallback: logChannelId)

  // Admin Permission Lock - sous-fonctionnalité : suspension auto en cas d'activité destructrice en rafale
  burstSuspendEnabled       Boolean @default(false)
  burstSuspendFastLimit     Int     @default(5)
  burstSuspendFastWindowSec Int     @default(1)
  burstSuspendSlowLimit     Int     @default(10)
  burstSuspendSlowWindowSec Int     @default(60)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("automod_configs")
}
