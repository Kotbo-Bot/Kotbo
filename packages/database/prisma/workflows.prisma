// ── Node Workflow Builder ────────────────────────────────────────────────────
// Automatisations no-code par blocs interconnectés. Le graphe est stocké en
// JSON (nœuds + fils), interprété par le moteur du bot au déclenchement d'un
// événement du bus.
//
// Système parallèle à AutoResponse : les deux coexistent sans interaction.

model Workflow {
  id      String @id @default(cuid())
  guildId String

  name        String
  description String?
  enabled     Boolean @default(false)

  // Événement du bus qui déclenche ce workflow, extrait du nœud déclencheur à
  // l'enregistrement. Dupliqué hors du JSON pour retrouver en une requête les
  // workflows concernés par un événement.
  triggerEvent String
  triggerType  String

  // { nodes: [...], edges: [...] } - voir @kotbo/shared
  graph Json

  createdById String?

  // ── Statistiques d'exécution ───────────────────────────────────────────────
  runCount     Int       @default(0)
  successCount Int       @default(0)
  failureCount Int       @default(0)
  lastRunAt    DateTime?
  lastError    String?

  guild      Guild               @relation(fields: [guildId], references: [id], onDelete: Cascade)
  executions WorkflowExecution[]
  memberRuns WorkflowMemberRun[]
  cooldowns  WorkflowCooldown[]
  keptMessages WorkflowKeptMessage[]
  sweep        WorkflowSweep?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, enabled])
  @@index([guildId, triggerEvent, enabled])
  @@map("workflows")
}

model WorkflowExecution {
  id         String @id @default(cuid())
  workflowId String
  guildId    String

  // RUNNING | WAITING (nœud Delay) | COMPLETED | FAILED | CANCELLED
  status String @default("RUNNING")

  // Payload de l'événement déclencheur, conservé pour rejouer l'exécution
  triggerPayload Json?

  // Valeurs mémorisées des ports de données, indispensables pour reprendre
  // après un Delay sans réévaluer un contexte Discord qui a pu changer.
  context Json?

  // Position courante lors d'une suspension
  currentNodeId String?
  // Pile des boucles ForEach en cours : [{ nodeId, index, items }]
  loopStack Json?

  // Échéance de reprise pour un nœud Delay (WAITING), ou fin du bail d'une
  // exécution reprise (RUNNING) au-delà de laquelle elle est réputée
  // interrompue ; null sinon
  resumeAt DateTime?

  // Consommation du budget, pour diagnostiquer une exécution interrompue
  nodeVisits Int @default(0)
  iterations Int @default(0)

  error String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  workflow Workflow                @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  guild    Guild                   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  steps    WorkflowExecutionStep[]

  @@index([workflowId, startedAt])
  @@index([guildId, startedAt])
  // Sert au cron de reprise : ne remonter que les exécutions arrivées à échéance
  @@index([status, resumeAt])
  @@map("workflow_executions")
}

// Trace nœud par nœud, qui alimente le rejeu visuel du dashboard : chaque étape
// conserve les valeurs entrées et sorties pour afficher ce qui a circulé sur
// chaque fil.
model WorkflowExecutionStep {
  id          String @id @default(cuid())
  executionId String

  // Rang d'exécution, pour rejouer le parcours dans l'ordre
  order    Int
  nodeId   String
  nodeType String

  // OK | ERROR | SKIPPED
  status String @default("OK")

  inputs  Json?
  outputs Json?
  error   String?

  durationMs Int      @default(0)
  startedAt  DateTime @default(now())

  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, order])
  @@map("workflow_execution_steps")
}

/// Rôle donné pour une durée par l'action « Donner un rôle temporaire ».
/// Un balayage à la minute retire le rôle à l'échéance puis efface la ligne.
model WorkflowTemporaryRole {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  roleId    String
  expiresAt DateTime
  /// Retraits refusés par Discord pour une raison passagère ; la ligne est
  /// abandonnée au-delà d'un plafond pour ne pas réessayer indéfiniment.
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId, roleId])
  @@index([expiresAt])
  @@map("workflow_temporary_roles")
}

/// Nombre de déclenchements d'un workflow pour un membre sur la période en
/// cours, lu par les conditions « au plus N fois aujourd'hui / cette heure ».
/// Une ligne par période : elle est remise à un quand la période change, ce
/// qui borne la table sans balayage de nettoyage.
model WorkflowMemberRun {
  workflowId String
  userId     String
  /// `day` ou `hour`
  period     String
  /// Jour (AAAA-MM-JJ) ou heure (AAAA-MM-JJTHH) dans le fuseau du serveur
  periodKey  String
  count      Int      @default(0)
  updatedAt  DateTime @updatedAt

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@id([workflowId, userId, period])
  @@map("workflow_member_runs")
}

/// Délai de récupération en cours, posé par un nœud « Délai de récupération ».
/// Une ligne par nœud et par titulaire (membre, salon, ou serveur pour une clé
/// vide) ; `until` est l'échéance. Une ligne échue est réutilisée au passage
/// suivant, et le balayage de nettoyage efface celles qui ne servent plus.
model WorkflowCooldown {
  workflowId String
  nodeId     String
  /// `member:<id>`, `channel:<id>`, ou vide pour tout le serveur
  subjectKey String
  until      DateTime

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@id([workflowId, nodeId, subjectKey])
  @@index([until])
  @@map("workflow_cooldowns")
}

/// Variable numérique d'un serveur, partagée entre toutes ses automatisations.
/// Tenue pour un membre (`subjectKey` = son identifiant) ou pour tout le
/// serveur (`subjectKey` vide).
model WorkflowVariable {
  guildId    String
  name       String
  subjectKey String
  value      Float    @default(0)
  updatedAt  DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, name, subjectKey])
  @@map("workflow_variables")
}

/// Message publié par une étape « Tenir un message à jour », modifié ensuite
/// à chaque passage au lieu d'en publier un nouveau.
model WorkflowKeptMessage {
  workflowId String
  nodeId     String
  channelId  String
  messageId  String
  updatedAt  DateTime @updatedAt

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@id([workflowId, nodeId])
  @@map("workflow_kept_messages")
}

/// Jusqu'où le balayage des déclencheurs d'ancienneté et d'inactivité est
/// allé : chaque passage prend les seuils tombés depuis, ni plus ni moins.
model WorkflowSweep {
  workflowId  String   @id
  sweptUntil  DateTime

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@map("workflow_sweeps")
}
