// ============================================================================
// SYSTÈME DE PLANNING & AGENDA (Tâches, Appels/Calls)
// ============================================================================

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model StaffTask {
  id          String       @id @default(cuid())
  guildId     String
  title       String
  description String?
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?

  assigneeId  String       // ID du StaffMember assigné
  creatorId   String       // ID du StaffMember créateur

  assignee    StaffMember  @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: Cascade)
  creator     StaffMember  @relation("CreatedTasks", fields: [creatorId], references: [id], onDelete: Cascade)
  guild       Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  reminders   StaffReminder[]
  // Carte de liste de suivi qui porte cette tâche, s'il y en a une.
  doingListItem DoingListItem?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([guildId, assigneeId])
  @@map("staff_tasks")
}

enum CallStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELED
}

model StaffCall {
  id               String            @id @default(cuid())
  guildId          String
  title            String
  description      String?
  scheduledAt      DateTime
  endedAt          DateTime?
  status           CallStatus        @default(SCHEDULED)

  creatorId        String            // ID du StaffMember créateur

  channelMode      String            // "CREATE_NEW", "EXISTING"
  channelType      String?           // "VOICE", "STAGE", "THREAD"
  discordChannelId String?           // ID du salon/thread associé
  isTempChannel    Boolean           @default(true)

  creator          StaffMember       @relation("CreatedCalls", fields: [creatorId], references: [id], onDelete: Cascade)
  guild            Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  invitees         StaffCallInvitee[]
  reminders        StaffReminder[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([guildId, scheduledAt])
  @@map("staff_calls")
}

model StaffCallInvitee {
  id           String      @id @default(cuid())
  callId       String
  staffUserId  String      // ID cuid du StaffMember

  joinedAt     DateTime?   // Si et quand le membre a rejoint le call

  call         StaffCall   @relation(fields: [callId], references: [id], onDelete: Cascade)
  staffMember  StaffMember @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@unique([callId, staffUserId])
  @@map("staff_call_invitees")
}

enum CallPermissionMode {
  EVERYONE
  RESTRICTED
}

// Contrôle qui peut planifier des appels depuis le Planning: tout le monde, ou une liste de rôles/membres Discord précise.
model CallPermissionConfig {
  guildId        String             @id
  mode           CallPermissionMode @default(EVERYONE)
  allowedRoleIds String[]           @default([])
  allowedUserIds String[]           @default([])

  guild          Guild              @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@map("call_permission_configs")
}

model StaffReminder {
  id          String        @id @default(cuid())
  guildId     String
  userId      String        // ID de l'utilisateur Discord à rappeler
  channelId   String?       // ID du salon Discord (null = en MP)
  message     String        // Message de rappel
  targetTime  DateTime      // Heure à laquelle envoyer le rappel
  fired       Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations optionnelles avec les éléments du planning
  taskId      String?
  callId      String?
  meetingId   String?

  task        StaffTask?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  call        StaffCall?    @relation(fields: [callId], references: [id], onDelete: Cascade)
  meeting     StaffMeeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  guild       Guild         @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, fired, targetTime])
  @@map("staff_reminders")
}

