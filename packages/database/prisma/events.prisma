// ============================================================================
// SYSTÈME D'ÉVÉNEMENTS
// ============================================================================

enum EventStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
}

enum EventType {
  QUIZ
  CTF
  CUSTOM
  TOURNAMENT
}

model Event {
  id String @id @default(cuid())
  guildId String
  title String
  description String?
  type EventType
  status EventStatus @default(DRAFT)
  channelId String?
  messageId String?

  // Custom event fields
  discordEventId         String?  // ID du GuildScheduledEvent Discord natif
  announcementChannelId  String?  // Salon où envoyer l'embed d'annonce
  announcementMessageId  String?  // ID du message d'annonce
  formId                 String?  // Formulaire d'inscription lié (optionnel)

  triggerType   String?   // "MEMBER_COUNT", "SCHEDULED"
  triggerValue  String?   // "1000", "2026-06-05T20:00:00Z"
  triggerStatus String    @default("PENDING") // "PENDING", "TRIGGERED", "FAILED"

  config Json? // { themeColor, etc. }

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  questions EventQuizQuestion[]
  ctfChallenges EventCtfChallenge[]
  participants EventParticipant[]
  registrations CustomEventRegistration[]
  tournamentMatches EventTournamentMatch[]
  customForm CustomForm? @relation(fields: [formId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, createdAt])
  @@map("events")
}

model CustomEventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  guildId   String
  userId    String
  username  String?
  userTag   String?

  // Réponses au formulaire si un formulaire était lié
  formData  Json?

  // Tournoi : tête de série posée à la génération de l'arbre (1 = la meilleure).
  // null tant que l'arbre n'est pas généré ; un numéro absent devient une exemption.
  seed      Int?
  // Tournoi par équipes : l'inscrit est le capitaine, ses coéquipiers à côté.
  teamName      String?
  teamMemberIds String[] @default([])

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([guildId, userId])
  @@map("custom_event_registrations")
}

// Résultat d'un match de tournoi. L'arbre lui-même se recalcule depuis les têtes
// de série : on ne stocke que les scores, avec les deux joueurs qui les ont
// joués. Si un résultat en amont change, les joueurs ne correspondent plus et le
// score devient caduc sans qu'il faille effacer quoi que ce soit en cascade.
model EventTournamentMatch {
  id        String   @id @default(cuid())
  eventId   String
  // W arbre principal, L arbre des perdants, GF grande finale, P3 petite finale,
  // G0..Gn poules, PO phase finale après les poules.
  stage     String   @default("W")
  round     Int      // 1 = premier tour
  position  Int      // 0 = match du haut de la colonne
  player1Id String
  player2Id String
  score1    Int      @default(0) // manches gagnées
  score2    Int      @default(0)
  sets      Json?    // détail des manches [[11, 7], [9, 11]] quand le tournoi le demande

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([eventId, stage, round, position])
  @@map("event_tournament_matches")
}

model EventQuizQuestion {
  id String @id @default(cuid())
  eventId String
  text String
  imageUrl String?
  options Json // Array of strings or objects { text, emoji }
  correctOptionIndex Int

  sortOrder Int @default(0)
  status EventStatus @default(DRAFT)

  startTime DateTime?
  endTime DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  responses EventQuizResponse[]

  @@map("event_quiz_questions")
}

model EventParticipant {
  id String @id @default(cuid())
  eventId String
  userId String
  guildId String

  userTag String?
  username String?

  score Int @default(0)
  lastSolveAt DateTime?
  metadata Json?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  profile MemberProfile @relation(fields: [guildId, userId], references: [guildId, userId], onDelete: Cascade)
  responses EventQuizResponse[]
  ctfSolves EventCtfSolve[]

  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  // Le profil d'un membre liste ses participations par serveur : la cle unique
  // commence par eventId et ne pouvait donc pas servir a ce filtre.
  @@index([guildId, userId])
  @@map("event_participants")
}

model EventQuizResponse {
  id String @id @default(cuid())
  questionId String
  participantId String

  optionIndex Int
  isCorrect Boolean
  responseTimeMs Int?

  question EventQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  participant EventParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([questionId, participantId])
  @@map("event_quiz_responses")
}

model EventCtfChallenge {
  id           String   @id @default(cuid())
  eventId      String
  title        String
  description  String
  flag         String   // Le flag attendu
  points       Int      @default(100)
  roleIdReward String?  // Rôle Discord attribué à la résolution
  xpReward     Int      @default(0)    // XP Kotbo attribuée
  imageUrl     String?
  sortOrder    Int      @default(0)

  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  solves       EventCtfSolve[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("event_ctf_challenges")
}

model EventCtfSolve {
  id            String            @id @default(cuid())
  challengeId   String
  participantId String
  solvedAt      DateTime          @default(now())

  challenge     EventCtfChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  participant   EventParticipant  @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([challengeId, participantId])
  @@map("event_ctf_solves")
}
