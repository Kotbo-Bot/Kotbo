// ============================================================================
// SALONS VOCAUX TEMPORAIRES — DEMANDES D'ACCÈS & RÉGLAGES ADMIN
// ============================================================================
// Complète tempVoiceEnabled / tempVoiceDefaults (guild.prisma) de deux volets :
//  - la demande d'accès qu'un inconnu peut envoyer sur un salon verrouillé ou
//    réservé (bouton « Demander l'accès », cf. tempVoice.ts:425) ;
//  - ce qu'un modérateur (isStaff) a le droit de faire sur un salon qui n'est
//    pas le sien, action par action — aujourd'hui tout ou rien dans le code.

model TempVoiceAccessRequestConfig {
  /// Une seule configuration par serveur.
  guildId String @id

  /// Un salon verrouillé ou réservé affiche un bouton « Demander l'accès ».
  /// Désactivé, le bouton n'apparaît jamais (comportement historique).
  enabled Boolean @default(false)

  /// Qui peut accepter ou refuser une demande : le propriétaire du salon
  /// seul, ou le propriétaire et les rôles reconnus comme staff (isStaff).
  responders String @default("OWNER_AND_STAFF") // OWNER | OWNER_AND_STAFF

  /// Où le propriétaire est prévenu en priorité. Un repli automatique
  /// s'enchaîne si ce choix échoue (MP fermés, salon dédié absent...) :
  /// resolveNoticeChannel essaie déjà broadcastChannelId, puis logChannelId,
  /// puis le salon système — la même cascade sert ici.
  notifyVia String @default("VOICE") // VOICE | DM | CHANNEL

  /// Salon dédié utilisé quand `notifyVia` vaut "CHANNEL".
  notifyChannelId String?

  /// Minutes avant qu'une demande en attente expire d'elle-même. Une demande
  /// expire aussi immédiatement si le salon disparaît (pas de ligne orpheline).
  requestExpiresMinutes Int @default(10)

  /// Minutes de silence imposées après un refus avant de pouvoir redemander
  /// sur le même salon.
  denyCooldownMinutes Int @default(10)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("temp_voice_access_request_configs")
}

/// ⚠️ Les sept lignes valent `true` par défaut, et ce n'est pas un détail de
/// confort : avant cette table, un membre du staff pouvait TOUT faire sur
/// n'importe quel salon temporaire. Un défaut restrictif fermerait au premier
/// enregistrement des portes que personne n'a demandé à fermer, et ferait
/// diverger le dashboard (qui lit les défauts du schéma) du bot (pour qui une
/// absence de ligne vaut le comportement d'avant). Poser des limites est un
/// geste explicite de l'administrateur.
model TempVoiceModPermissionsConfig {
  /// Une seule configuration par serveur.
  guildId String @id

  /// Un modérateur (isStaff) peut renommer n'importe quel salon temporaire.
  canRename Boolean @default(true)
  /// Un modérateur peut changer la limite de places.
  canChangeLimit Boolean @default(true)
  /// Un modérateur peut verrouiller / déverrouiller un salon.
  canLock Boolean @default(true)
  /// Un modérateur peut changer qui a le droit d'écrire dans le salon.
  canChangeWriteMode Boolean @default(true)
  /// Un modérateur peut expulser ou bannir un membre du salon.
  canKickOrBan Boolean @default(true)
  /// Un modérateur peut réserver le salon à un rôle.
  canReserve Boolean @default(true)
  /// Un modérateur peut transférer la propriété du salon.
  canTransfer Boolean @default(true)

  /// Comment se comportent les sous-panneaux éphémères du salon.
  ///
  /// `false` — chaque action ouvre un éphémère de plus. C'est le comportement
  /// livré, et il reste le défaut : personne n'a demandé qu'on le change.
  /// `true` — un seul éphémère, réécrit sur place, avec un bouton « Retour ».
  /// Trois messages pour une réservation (le menu, le choix, le verdict)
  /// deviennent un seul.
  panelCompactMode Boolean @default(false)

  /// Les rôles proposés dans le menu « Réserver le salon ».
  ///
  /// Vide — le menu laisse choisir n'importe quel rôle du serveur, ce qui est
  /// le comportement livré. Non vide — seuls ces rôles sont proposés, et un
  /// propriétaire ne peut plus réserver son salon à un rôle que
  /// l'administration n'a pas prévu.
  reservableRoleIds String[] @default([])

  /// Ce qu'on fait des personnes déjà dans le salon qui n'ont pas le rôle au
  /// moment où il est réservé.
  ///
  /// Réserver ne déplace personne : les gens restent dans un salon qu'ils
  /// n'auraient plus le droit de rejoindre. `ASK` pose la question au
  /// propriétaire, et ne la pose que lorsqu'il y a quelqu'un à qui elle
  /// s'applique. Les trois autres valeurs tranchent d'avance.
  reservationOverflow String @default("ASK") // ASK | NOTHING | MOVE | DISCONNECT

  /// Salon vers lequel déplacer, quand la décision est « MOVE ». Absent, le
  /// déplacement se rabat sur une déconnexion — annoncée comme telle.
  reservationFallbackChannelId String?

  /// Organisation du panneau de gestion du salon temporaire.
  ///
  /// `CLASSIC` (défaut) — les trois portes actuelles (Salon / Membres /
  /// Propriété), chacune un éphémère séparé, avec recherche de n'importe qui
  /// du serveur. C'est le comportement livré aujourd'hui, donc le défaut :
  /// un déploiement ne doit rien changer tant qu'un administrateur n'a pas
  /// ouvert l'onglet.
  /// `FLAT` — tout sur un seul écran, actions limitées aux seuls membres
  /// déjà présents en vocal, pas de recherche.
  panelMode String @default("CLASSIC") // CLASSIC | FLAT

  /// Mise en page des six valeurs d'état du salon (État / Places / Écriture /
  /// Autorisés / Bannis / Réservé).
  ///
  /// `GRID3` (défaut) reproduit les six champs inline actuels : rien ne
  /// change tant que l'administrateur n'a pas choisi une autre disposition.
  stateLayout String @default("GRID3") // GRID3 | GRID2 | TABLE | CARDS

  /// Palette utilisée uniquement pour les rendus image du panneau (aucun
  /// effet sur les embeds ou les Components V2, qui suivent le thème Discord
  /// du client). `NEUTRAL` (défaut) reproduit le rendu actuel.
  stateColors String @default("NEUTRAL") // NEUTRAL | DARK | LIGHT

  /// Format d'affichage du panneau de gestion.
  ///
  /// `V1` — embed classique à champs inline.
  /// `V2` (défaut) — Container Components V2. Le défaut vaut V2 et non V1
  /// parce que c'est déjà le comportement livré aujourd'hui : le patch qui
  /// convertit tout en V2 s'applique sans bascule, avant même cette colonne.
  panelComponents String @default("V2") // V1 | V2

  /// Ce que fait le bouton « Réserver » quand la personne n'a AUCUN des
  /// rôles listés dans `reservableRoleIds`.
  ///
  /// `MEMBERS` — un UserSelect multiple verrouille le salon et autorise les
  /// personnes choisies individuellement.
  /// `ANY_ROLE` (défaut) — le menu propose n'importe quel rôle du serveur :
  /// c'est le comportement livré aujourd'hui, donc le défaut qui ne change
  /// rien tant que l'administrateur n'a pas ouvert l'onglet.
  /// `FORBIDDEN` — refus motivé, aucune réservation possible dans ce cas.
  reservationFallbackMode String @default("ANY_ROLE") // MEMBERS | ANY_ROLE | FORBIDDEN

  /// ⚠️ L'INTERRUPTEUR de la personnalisation par générateur — et c'est d'abord
  /// une SORTIE DE SECOURS, pas un confort.
  ///
  /// `false` (défaut) — les cinq réglages ci-dessus valent pour TOUS les salons
  /// du serveur, générateur principal comme additionnels. Les surcharges posées
  /// sur les générateurs ne sont même pas lues.
  /// `true` — chaque salon suit d'abord la surcharge de SON générateur
  /// (`Guild.tempVoiceGenerators`), et retombe champ par champ sur le réglage du
  /// serveur pour tout ce que ce générateur ne surcharge pas.
  ///
  /// Le défaut est FAUX délibérément : au déploiement, aucun serveur existant ne
  /// change de comportement, et on allume quand on veut. Si la personnalisation
  /// par générateur pose le moindre problème en production, la couper depuis le
  /// dashboard suffit à revenir au comportement actuel — sans redéploiement.
  ///
  /// Couper l'interrupteur IGNORE les surcharges, il ne les EFFACE PAS : elles
  /// restent dans `Guild.tempVoiceGenerators` et reviennent telles quelles au
  /// rallumage. Les effacer serait une perte de données silencieuse, et rien ne
  /// distinguerait plus « éteint » de « jamais réglé ».
  perGeneratorPresentation Boolean @default(false)

  /// Passation d'un salon dont le propriétaire part.
  ///
  /// Le propriétaire qui part en laissant du monde reçoit en MP le menu des
  /// présents, valable `handoverDelaySeconds` secondes (10 à 300) : pendant ce
  /// temps, seuls son choix et le staff changent la propriété.
  handoverDmEnabled Boolean @default(true)
  handoverDelaySeconds Int @default(30)
  /// Sans choix (délai écoulé, MP fermés ou désactivés), un message
  /// « Récupérer le salon » est posté dans le chat du salon.
  claimEmbedEnabled Boolean @default(true)
  /// Qui peut récupérer le salon : tout membre présent (modérateurs compris)
  /// ou le staff seul. Le staff le peut à tout moment.
  claimWho String @default("present") // present | moderators
  /// Le staff peut annuler la réclamation d'un membre : le salon redevient à
  /// récupérer.
  moderatorClaimOverride Boolean @default(true)
  /// Un salon vide est supprimé. Faux : il reste, et le premier qui entre
  /// peut le récupérer.
  deleteWhenEmpty Boolean @default(true)

  /// Où se trouve la mention qui notifie le propriétaire à la création du salon.
  ///
  /// `panel` (défaut) — dans le panneau de gestion lui-même, comme avant cette
  /// colonne : rien ne change tant que l'administrateur n'a pas choisi.
  /// `message` — dans un message distinct au-dessus du panneau (la notification
  /// part même si le panneau est en Components V2).
  /// `none` — aucune mention : le propriétaire n'est pas notifié.
  ownerMentionPlacement String @default("panel") // panel | message | none

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("temp_voice_mod_permissions_configs")
}
