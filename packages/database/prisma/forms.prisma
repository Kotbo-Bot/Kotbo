// ============================================================================
// FORMULAIRES AUTONOMES
// ============================================================================

model CustomForm {
  id          String   @id @default(cuid())
  guildId     String
  name        String
  description String?
  isActive    Boolean  @default(true)
  isRecruitment Boolean @default(false)
  // Force la connexion Discord avant de pouvoir remplir le formulaire.
  // Toujours vrai pour les formulaires de recrutement (voir isRecruitment).
  requiresDiscordAuth Boolean @default(false)

  // Structure du formulaire (même format que RecruitmentForm)
  structure   Json

  // Apparence personnalisée : bannière, logo, couleurs, police, radius...
  // Voir CustomFormTheme dans customFormService.ts
  theme       Json?
  // CSS custom, sanitizé côté serveur à la sauvegarde ET au service
  customCss   String?

  // Hiérarchie staff associée (formulaires de recrutement) : détermine le
  // rôle/grade attribué automatiquement lors de l'embauche depuis ce formulaire.
  // null = comportement historique (rôle le plus bas toutes hiérarchies confondues).
  hierarchyId String?

  // ── Fermeture automatique (formulaires de recrutement) ───────────────────
  // Ferme le poste a X candidatures en attente ; il rouvre quand l'une d'elles
  // est tranchee (retenue pour l'oral ou refusee).
  maxPendingCandidatures  Int?
  // Ferme le poste a X candidats recrutes (oral reussi).
  maxAcceptedCandidatures Int?
  // RESET : le compteur d'acceptes repart a 0 a chaque reouverture manuelle.
  // TOTAL : tous les acceptes du formulaire comptent, depuis toujours.
  acceptedCapMode         String  @default("RESET")
  acceptedCount           Int     @default(0)
  // PENDING | ACCEPTED quand Kotbo a ferme le poste lui-meme. Seule une
  // fermeture automatique se rouvre automatiquement : une fermeture a la main
  // n'est jamais annulee par le bot.
  autoClosedReason        String?

  // Relation optionnelle vers un Event (événement d'inscription)
  events      Event[]
  candidatures RecruitmentCandidature[]
  appealConfigs BanAppealConfig[]

  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  hierarchy   StaffHierarchy? @relation("CustomFormHierarchy", fields: [hierarchyId], references: [id], onDelete: SetNull)
  submissions CustomFormSubmission[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([guildId])
  @@index([hierarchyId])
  @@map("custom_forms")
}

model CustomFormSubmission {
  id        String     @id @default(cuid())
  formId    String
  guildId   String
  userId    String?    // Discord user ID (si soumis via bouton Discord)
  username  String?
  userTag   String?
  data      Json       // Réponses au formulaire

  form      CustomForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  guild     Guild      @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime   @default(now())

  @@index([formId])
  @@index([formId, createdAt(sort: Desc)])
  @@index([guildId, userId])
  @@map("custom_form_submissions")
}
