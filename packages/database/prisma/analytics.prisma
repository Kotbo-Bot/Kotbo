// ============================================================================
// ANALYTICS - STATISTIQUES SERVEUR
// ============================================================================

model GuildDailyStat {
  id String @id @default(cuid())

  guildId String
  dateKey String // YYYY-MM-DD

  totalMembers     Int @default(0)
  onlineMembers    Int @default(0)
  idleMembers      Int @default(0)
  dndMembers       Int @default(0)
  offlineMembers   Int @default(0)
  totalBots        Int @default(0)
  totalHumans      Int @default(0)

  messagesCount    Int @default(0)
  reactionsCount   Int @default(0)
  voiceMinutes     Int @default(0)
  voiceSessionsCount Int @default(0)

  membersJoined    Int @default(0)
  membersLeft      Int @default(0)

  sanctionsCount   Int @default(0)
  warnsCount       Int @default(0)
  kicksCount       Int @default(0)
  timeoutsCount    Int @default(0)
  bansCount        Int @default(0)

  activeMembers    Int @default(0) // Membres ayant envoyé >= 1 message
  activeVoiceMembers Int @default(0) // Membres ayant rejoint >= 1 vocal

  peakOnline       Int @default(0) // Pic de membres en ligne dans la journée
  peakVoice        Int @default(0) // Pic de membres en vocal simultanément

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, dateKey])
  @@map("guild_daily_stats")
}


model ChannelDailyStat {
  id String @id @default(cuid())

  guildId   String
  channelId String
  dateKey   String // YYYY-MM-DD

  messagesCount Int @default(0)
  uniqueAuthors Int @default(0)
  voiceMinutes  Int @default(0)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, channelId, dateKey])
  @@index([guildId, dateKey])
  @@map("channel_daily_stats")
}


// Fréquence des mots par jour - agrégat anonyme (aucun contenu brut, aucun auteur).
// Alimenté à la volée par le tracker de messages quand wordStatsEnabled est actif.
model GuildWordStat {
  id      String @id @default(cuid())
  guildId String
  dateKey String // YYYY-MM-DD
  word    String
  count   Int    @default(0)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, dateKey, word])
  @@index([guildId, dateKey])
  @@map("guild_word_stats")
}

// Contenu des messages : ce que les membres postent (types, emojis, stickers,
// GIF, mise en forme). Une ligne par (serveur, jour, salon, membre) pour
// pouvoir filtrer à la fois par salon, catégorie, membre et rôle. Un message
// posté dans un fil compte pour le salon parent (styleThread le distingue).
// Aucun texte ni lien n'est stocké : seulement des compteurs.
model MessageContentDailyStat {
  id String @id @default(cuid())

  guildId   String
  dateKey   String // YYYY-MM-DD
  channelId String
  userId    String

  messages       Int @default(0)
  withEmoji      Int @default(0)
  withMarkdown   Int @default(0)
  withLink       Int @default(0)
  withMedia      Int @default(0)
  // Messages ayant reçu au moins une réaction, comptés au jour du message.
  reactedMessages Int @default(0)

  // Type principal : chaque message compte dans un seul de ces compteurs.
  typeText    Int @default(0)
  typeImage   Int @default(0)
  typeGif     Int @default(0)
  typeVideo   Int @default(0)
  typeSticker Int @default(0)
  typeFile    Int @default(0)
  typeAudio   Int @default(0)
  typeVoice   Int @default(0) // message vocal Discord
  typePoll    Int @default(0)
  typeLink    Int @default(0)
  typeForward Int @default(0)

  styleReply   Int @default(0)
  styleMention Int @default(0)
  styleThread  Int @default(0)
  styleEdited  Int @default(0)
  emojiOnly    Int @default(0)
  lenShort     Int @default(0) // moins de 20 caractères
  lenMedium    Int @default(0)
  lenLong      Int @default(0) // plus de 200 caractères

  // Messages utilisant chaque style markdown (un message peut en cumuler).
  mdBold       Int @default(0)
  mdItalic     Int @default(0)
  mdUnderline  Int @default(0)
  mdStrike     Int @default(0)
  mdSpoiler    Int @default(0)
  mdInlineCode Int @default(0)
  mdCodeBlock  Int @default(0)
  mdQuote      Int @default(0)
  mdHeading    Int @default(0)
  mdList       Int @default(0)
  mdMaskedLink Int @default(0)
  mdSubtext    Int @default(0)

  // Occurrences d'emojis dans les messages.
  emojiUnicode  Int @default(0)
  emojiGuild    Int @default(0)
  emojiExternal Int @default(0)
  emojiAnimated Int @default(0)

  stickerGuild    Int @default(0)
  stickerExternal Int @default(0)
  stickerStandard Int @default(0)

  gifTenor  Int @default(0)
  gifGiphy  Int @default(0)
  gifUpload Int @default(0)
  gifOther  Int @default(0)

  // Réactions posées par ce membre dans ce salon.
  reactUnicode  Int @default(0)
  reactGuild    Int @default(0)
  reactExternal Int @default(0)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, dateKey, channelId, userId])
  @@index([guildId, userId, dateKey])
  @@map("message_content_daily_stats")
}

// Classements de contenu (emojis, stickers, réactions, domaines) par jour.
// Chaque occurrence incrémente deux lignes : une par salon (userId = "") et
// une par membre (channelId = ""). Le total serveur est la somme des lignes
// par salon. Croiser salon ET membre n'est pas prévu : ce serait le produit
// des deux, pour un gain marginal.
model ContentItemDailyStat {
  id String @id @default(cuid())

  guildId   String
  dateKey   String // YYYY-MM-DD
  // emoji_unicode | emoji_guild | emoji_external | sticker_guild |
  // sticker_external | sticker_standard | reaction_unicode | reaction_guild |
  // reaction_external | domain
  kind      String
  key       String // id d'emoji ou de sticker, caractère Unicode, domaine
  channelId String @default("")
  userId    String @default("")
  count     Int    @default(0)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, dateKey, kind, key, channelId, userId])
  @@index([guildId, userId, dateKey])
  @@map("content_item_daily_stats")
}

// Provenance des emojis et stickers vus sur les serveurs, partagée entre tous
// les serveurs : un id n'est résolu qu'une fois, même quand la réponse est
// « inconnu ». Voir services/analytics/assetSourceService.ts.
model DiscordAssetSource {
  id   String @id // id Discord de l'emoji ou du sticker
  kind String // emoji | sticker

  name     String?
  animated Boolean @default(false)

  sourceGuildId   String?
  sourceGuildName String?
  sourceGuildIcon String?

  status    String    @default("pending") // pending | resolved | unknown
  attempts  Int       @default(0)
  checkedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, checkedAt])
  @@map("discord_asset_sources")
}

model MemberInvite {
  id String @id @default(cuid())

  guildId String
  userId  String // L'utilisateur qui a rejoint

  inviteCode  String?
  inviterId   String? // L'utilisateur qui a invité
  inviterTag  String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())
  leftAt   DateTime? // Quand l'utilisateur est parti

  @@index([guildId, inviterId])
  @@index([guildId, joinedAt])
  @@index([guildId, inviteCode])
  @@index([guildId, userId, joinedAt])
  @@map("member_invites")
}

model GuildInvite {
  id String @id @default(cuid())

  guildId String
  code    String @unique

  inviterId   String?
  inviterTag  String?
  sourceLabel String? // Provenance personnalisée (TikTok, Instagram, campagne, etc.)

  uses        Int @default(0)
  maxUses     Int?
  expiresAt   DateTime?

  isTemporary Boolean @default(false)
  isDeleted   Boolean @default(false)
  isSuspended Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, inviterId])
  @@map("guild_invites")
}

model SuspendedInviter {
  id        String   @id @default(cuid())
  guildId   String
  userId    String   // ID Discord du créateur
  userTag   String?  // Tag de l'utilisateur
  reason    String?  // Raison de la suspension
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@map("suspended_inviters")
}

model GuildHourlyStat {
  id       String @id @default(cuid())

  guildId  String
  dateKey  String // YYYY-MM-DD
  hour     Int    // 0-23

  messagesCount Int @default(0)
  voiceMinutes  Int @default(0)
  joinsCount    Int @default(0)
  leavesCount   Int @default(0)
  reactionsCount Int @default(0)
  threadsCount  Int @default(0)

  onlineMembers Int @default(0)
  voiceMembers  Int @default(0)
  activeMembers Int @default(0)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, dateKey, hour])
  @@map("guild_hourly_stats")
}

model MemberDailyStat {
  id       String @id @default(cuid())

  guildId  String
  userId   String
  dateKey  String // YYYY-MM-DD

  messagesCount    Int @default(0)
  voiceMinutes     Int @default(0)
  reactionsCount   Int @default(0)
  threadsCreated   Int @default(0)
  repliesCount     Int @default(0)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, userId, dateKey])
  @@index([guildId, dateKey])
  @@map("member_daily_stats")
}


model DashboardCommandUsage {
  id String @id @default(cuid())
  guildId String
  commandName String
  userId String?
  count Int @default(1)
  lastUsedAt DateTime @default(now())

  @@unique([guildId, commandName, userId])
  @@index([guildId, commandName])
  @@map("dashboard_command_usages")
}

// ============================================================================
// MODULE STATISTICS - STATISTIQUES GLOBALES DES MODULES KOTBO
// ============================================================================

model ModuleActivationStat {
  id String @id @default(cuid())

  guildId String? // null = global (tous serveurs)
  moduleName String // ex: "dailyAlgo", "sanction", "ticket", etc.
  enabled Boolean @default(false)

  // Configuration spécifique au module
  config Json? // Pour stocker des configs spécifiques

  guild Guild? @relation(fields: [guildId], references: [id], onDelete: Cascade)

  activatedAt DateTime?
  deactivatedAt DateTime?
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, moduleName])
  @@index([guildId, enabled])
  @@index([moduleName, enabled])
  @@map("module_activation_stats")
}

model ModuleUsageStat {
  id String @id @default(cuid())

  guildId String? // null = global
  moduleName String
  dateKey String // YYYY-MM-DD

  // Compteurs d'utilisation
  commandExecutions Int @default(0)
  apiCalls Int @default(0)
  eventTriggers Int @default(0)

  // Détails par type d'action
  actionBreakdown Json? // { "create": 10, "update": 5, "delete": 2 }

  // Utilisateurs uniques
  uniqueUsers Int @default(0)
  topUsers Json? // Array of { userId, count }

  guild Guild? @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, moduleName, dateKey])
  @@index([guildId, dateKey])
  @@index([moduleName, dateKey])
  @@map("module_usage_stats")
}

model ModulePerformanceStat {
  id String @id @default(cuid())

  guildId String? // null = global
  moduleName String
  dateKey String // YYYY-MM-DD

  // Performance
  avgExecutionTimeMs Float @default(0)
  maxExecutionTimeMs Float @default(0)
  minExecutionTimeMs Float @default(0)
  totalExecutions Int @default(0)

  // Erreurs
  errorCount Int @default(0)
  errorRate Float @default(0) // percentage
  errorTypes Json? // { "timeout": 5, "permission": 2, etc. }

  // Succès
  successCount Int @default(0)
  successRate Float @default(0) // percentage

  guild Guild? @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, moduleName, dateKey])
  @@index([guildId, dateKey])
  @@index([moduleName, dateKey])
  @@map("module_performance_stats")
}

// Note datée posée sur les courbes d'Analytics (« tournoi », « pub sur X »).
// Tout lecteur d'Analytics peut en poser ; l'auteur est affiché.
model AnalyticsAnnotation {
  id String @id @default(cuid())

  guildId  String
  dateKey  String // YYYY-MM-DD, jour du repère
  label    String
  authorId String

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([guildId, dateKey])
  @@map("analytics_annotations")
}

// Qui répond à qui, et qui mentionne qui : un compteur par paire et par jour,
// jamais le contenu. Suit Guild.analyticsEnabled.
model MemberInteractionDailyStat {
  id String @id @default(cuid())

  guildId      String
  dateKey      String // YYYY-MM-DD
  userId       String // auteur du message
  targetUserId String // membre à qui il répond ou qu'il mentionne

  replies  Int @default(0)
  mentions Int @default(0)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, dateKey, userId, targetUserId])
  @@index([guildId, dateKey])
  @@map("member_interaction_daily_stats")
}

// Temps de réponse par salon : un « tour » est la prise de parole d'un membre ;
// il est répondu quand un autre membre écrit dans le salon dans les 6 h. Les
// délais sont rangés par tranches pour estimer la médiane sans les stocker.
model ChannelResponseDailyStat {
  id String @id @default(cuid())

  guildId   String
  dateKey   String // jour du tour
  channelId String

  answered    Int @default(0)
  unanswered  Int @default(0)
  delaySumSec Int @default(0)
  under1m     Int @default(0)
  under5m     Int @default(0)
  under15m    Int @default(0)
  under1h     Int @default(0)
  under6h     Int @default(0)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, dateKey, channelId])
  @@index([guildId, dateKey])
  @@map("channel_response_daily_stats")
}

// Alerte sur seuil d'Analytics : « préviens-moi si l'activité baisse de 30 % »,
// « si un salon dépasse 200 messages par heure ». Évaluée par le cron
// analytics-alerts ; envoyée dans un salon et/ou en MP aux membres choisis.
model AnalyticsAlertRule {
  id String @id @default(cuid())

  guildId   String
  name      String
  metric    String  // messages | voiceMinutes | activeMembers | joins | leaves | netJoins | sanctions | channelRate | unansweredRate
  condition String  // drop_pct | rise_pct | above | below
  threshold Float
  window    String  // hour | day | week
  channelId String? // pour channelRate (et pour restreindre messages à un salon)

  notifyChannelId String?
  notifyUserIds   String[] @default([])
  enabled         Boolean  @default(true)
  cooldownHours   Int      @default(24)

  lastPeriodKey   String?   // dernière période évaluée, pour ne pas réévaluer
  lastTriggeredAt DateTime?
  createdById     String

  guild  Guild                 @relation(fields: [guildId], references: [id], onDelete: Cascade)
  events AnalyticsAlertEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
  @@index([enabled])
  @@map("analytics_alert_rules")
}

// Déclenchements d'alerte, pour l'historique affiché dans Analytics.
model AnalyticsAlertEvent {
  id String @id @default(cuid())

  guildId   String
  ruleId    String
  periodKey String
  value     Float
  baseline  Float?
  delivered Boolean @default(true)

  rule AnalyticsAlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  triggeredAt DateTime @default(now())

  @@index([guildId, triggeredAt])
  @@index([ruleId, triggeredAt])
  @@map("analytics_alert_events")
}

// Rapport d'Analytics envoyé à intervalle régulier dans un salon et/ou en MP.
model AnalyticsReportSchedule {
  id String @id @default(cuid())

  guildId   String
  frequency String  // weekly | monthly
  weekday   Int     @default(1) // 0 = dimanche, pour weekly
  monthDay  Int     @default(1) // 1-28, pour monthly
  hour      Int     @default(9) // heure locale du serveur
  channelId String?
  userIds   String[] @default([])
  sections  String[] @default([])
  enabled   Boolean  @default(true)

  nextRunAt  DateTime
  lastSentAt DateTime?
  createdById String

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
  @@index([enabled, nextRunAt])
  @@map("analytics_report_schedules")
}

// Vue enregistrée d'Analytics : onglet, période, filtres et comparaison, pour
// y revenir en un clic. Privée à son auteur, ou partagée avec l'équipe.
model AnalyticsSavedView {
  id String @id @default(cuid())

  guildId String
  userId  String
  name    String
  payload Json
  shared  Boolean @default(false)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([guildId, userId])
  @@map("analytics_saved_views")
}

// Usage des commandes slash, par jour, commande (avec sous-commande) et membre.
// Suit Guild.analyticsEnabled. Remplace, pour Analytics, le cumul sans date de
// dashboard_command_usages.
model CommandUsageDailyStat {
  id String @id @default(cuid())

  guildId     String
  dateKey     String // YYYY-MM-DD
  commandName String // « rank », « ticket ouvrir »
  userId      String

  uses    Int @default(0)
  errors  Int @default(0)
  totalMs Int @default(0)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, dateKey, commandName, userId])
  @@index([guildId, dateKey])
  @@map("command_usage_daily_stats")
}
