{
  "name": "@kotbo/bot",
  "version": "10.0",
  "private": true,
  "scripts": {
    "migrate:deploy": "cd ../.. && bun run db:migrate:deploy",
    "build:i18n": "bunx @inlang/paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --output-structure locale-modules",
    "prestart": "bun run build:i18n",
    "build": "bun run build:i18n && bun run typecheck",
    "dev": "bun run build:i18n && bun run --watch src/launcher.ts",
    "dev:safe": "bun run build:i18n && bun run quality:gate && bun run --watch src/launcher.ts",
    "start": "bun run src/launcher.ts",
    "start:safe": "bun run quality:gate && bun run src/launcher.ts",
    "deploy-commands": "bun run build:i18n && bun run src/deploy-commands.ts",
    "test:unit": "bun run build:i18n && BUN_TEST_RUNNING=1 bun test --isolate --timeout 30000 src/tests",
    "test:coverage": "bun run build:i18n && BUN_TEST_RUNNING=1 bun test --isolate --timeout 30000 --coverage src/tests",
    "coverage:gate": "bun run scripts/coverage-gate.ts",
    "test:watch": "BUN_TEST_RUNNING=1 bun test --isolate --timeout 30000 --watch src/tests",
    "typecheck": "bun x tsgo -p tsconfig.json --noEmit --checkers 2",
    "typecheck:tsc": "bun x tsc -p tsconfig.json --noEmit",
    "quality:gate": "bun run build:i18n && bun run typecheck && bun run lint && bun run test:unit && bun run coverage:gate",
    "lint": "eslint src --ext .ts --cache --cache-location node_modules/.cache/eslint"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@arcscord/components": "^1.0.2",
    "@aws-sdk/client-ses": "^3.1175.0",
    "@discordjs/voice": "0.19.2",
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^0.19.10",
    "@kotbo/contracts": "workspace:*",
    "@kotbo/core": "workspace:*",
    "@kotbo/database": "workspace:*",
    "@kotbo/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/canvas": "^0.1.100",
    "@opentelemetry/core": "^2.12.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/client-runtime-utils": "^7.10.1",
    "@sentry/bun": "^10.78.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bullmq": "^5.81.6",
    "discord.js": "^14.28.1",
    "dotenv": "^16.6.1",
    "fflate": "^0.8.3",
    "franc-min": "^6.2.0",
    "hono": "^4.13.19",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "lib0": "^0.2.120",
    "libsodium-wrappers": "0.8.4",
    "lru-cache": "11.5.3",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.6.1",
    "p-limit": "5.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "rss-parser": "^3.13.0",
    "socket.io": "^4.8.4",
    "stripe": "^22.6.2",
    "tesseract.js": "^7.0.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.29.3",
    "@types/node": "^22.20.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "eslint": "^8.57.1",
    "typescript": "^5.9.3"
  }
}
